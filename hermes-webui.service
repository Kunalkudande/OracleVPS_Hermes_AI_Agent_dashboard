[Unit]
Description=Hermes WebUI for the private control room
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/hermes-webui
Environment=HERMES_HOME=%h/.hermes
Environment=HERMES_WEBUI_AGENT_DIR=%h/.hermes/hermes-agent
Environment=HERMES_WEBUI_STATE_DIR=%h/.hermes/webui
Environment=HERMES_WEBUI_HOST=127.0.0.1
Environment=HERMES_WEBUI_PORT=8787
Environment=HERMES_WEBUI_TRUSTED_AUTH_HEADER=X-Hermes-Control-User
Environment=HERMES_WEBUI_TRUSTED_PROXY_CIDRS=127.0.0.1/32
Environment=HERMES_WEBUI_SKIP_ONBOARDING=1
Environment=HERMES_WEBUI_MAX_UPLOAD_MB=4
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/hermes-webui/bootstrap.py --foreground --no-browser --skip-agent-install
Restart=on-failure
RestartSec=10
UMask=0077
NoNewPrivileges=yes
MemoryMax=2G
TasksMax=256

[Install]
WantedBy=default.target
