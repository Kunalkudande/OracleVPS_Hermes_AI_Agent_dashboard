{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/bridge.mjs": {
      "maxDuration": 60
    },
    "api/webui.mjs": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/hermes/:path*",
      "destination": "/api/webui?path=:path*"
    },
    {
      "source": "/api/:route*",
      "destination": "/api/bridge?route=:route*"
    }
  ],
  "headers": [
    {
      "source": "/((?!hermes(?:/|$)).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/hermes",
      "destination": "/hermes/",
      "permanent": false
    }
  ]
}
