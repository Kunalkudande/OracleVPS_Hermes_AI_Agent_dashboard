# Set these in Vercel > Project > Settings > Environment Variables.
# Use Production only; do not give untrusted Preview builds access to the VPS.
HERMES_SSH_HOST=YOUR_VPS_IP
HERMES_SSH_USER=ubuntu
# SHA256 host-key hash in hexadecimal, obtained through the trusted SSH connection.
HERMES_SSH_HOST_SHA256=YOUR_VERIFIED_HOST_KEY_HASH
# Dedicated restricted key, never your administrator's key. Paste the whole multiline key.
HERMES_SSH_PRIVATE_KEY=YOUR_RESTRICTED_BRIDGE_PRIVATE_KEY
# Your stable production URL, no trailing slash. Keep this explicit.
HERMES_PUBLIC_ORIGIN=https://YOUR_PROJECT.vercel.app
